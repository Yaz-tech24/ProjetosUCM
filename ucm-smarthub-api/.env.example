# Copie este ficheiro para .env e preencha os valores reais.
# NUNCA comite o .env real — já está no .gitignore.

# ─── Servidor ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origens permitidas no CORS (separadas por vírgula, sem espaços à volta)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# URL pública desta API (usada para construir links de ficheiros em /uploads)
API_URL=http://localhost:5000
# URL pública do frontend (usada para construir o link de recuperação de password)
FRONTEND_URL=http://localhost:5173

# ─── Base de dados MySQL ───────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD= 
DB_NAME=ucm_smarthub

# ─── Autenticação ──────────────────────────────────────────
# Gere uma chave longa e aleatória para produção (ex: openssl rand -hex 32).
# Obrigatória quando NODE_ENV=production — o servidor recusa-se a arrancar
# sem ela, para não cair silenciosamente numa chave de desenvolvimento
# conhecida (visível no código-fonte).
JWT_SECRET=

# ─── IA (Google Gemini) — opcional ─────────────────────────
# Sem esta chave, o resumo por IA, o chat e a moderação automática ficam desactivados
# (a app continua a funcionar normalmente, só sem estas funcionalidades).
GEMINI_API_KEY=

# ─── Email (SMTP) — opcional ────────────────────────────────
# Sem estas variáveis, os emails (boas-vindas, recuperação de password,
# notificação de moderação) não são enviados — a app regista um aviso e continua.
# Compatível com qualquer serviço SMTP: Gmail, SendGrid, Resend, Mailtrap, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
