# Copie este ficheiro para .env e preencha os valores reais.
# NUNCA comite o .env real — já está no .gitignore.

# ─── Servidor ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origens permitidas no CORS (separadas por vírgula, sem espaços à volta)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# URL pública desta API (usada para construir links de ficheiros em /uploads)
API_URL=http://localhost:5000
# URL pública do frontend (usada para construir o link de recuperação de password)
FRONTEND_URL=http://localhost:5173

# ─── Base de dados MySQL ───────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD= 
DB_NAME=ucm_smarthub
DB_PORT=3306

# ─── Autenticação ──────────────────────────────────────────
# Gere uma chave longa e aleatória para produção (ex: openssl rand -hex 32).
# Obrigatória quando NODE_ENV=production — o servidor recusa-se a arrancar
# sem ela, para não cair silenciosamente numa chave de desenvolvimento
# conhecida (visível no código-fonte).
JWT_SECRET=

# ─── IA (Google Gemini) — opcional ─────────────────────────
# Sem esta chave, o resumo por IA, o chat e a moderação automática ficam desactivados
# (a app continua a funcionar normalmente, só sem estas funcionalidades).
GEMINI_API_KEY=

# ─── Email (SMTP) — opcional ────────────────────────────────
# Sem estas variáveis, os emails (boas-vindas, recuperação de password,
# notificação de moderação) não são enviados — a app regista um aviso e continua.
# Compatível com qualquer serviço SMTP: Gmail, SendGrid, Resend, Mailtrap, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Caminho explícito do LibreOffice para converter DOCX/PPTX em PDF (opcional —
# por defeito procura "soffice"/"libreoffice" no PATH). Sem LibreOffice, a
# conversão fica indisponível e o upload de documentos Office é recusado com aviso.
SOFFICE_PATH=

# Só para desenvolvimento/testes automatizados: desliga os limitadores de taxa.
# Ignorado quando NODE_ENV=production.
DESATIVAR_RATE_LIMIT=

# ─── Monitor de saúde e alertas (Admin → Sistema) ───────────
# Pasta onde estão os backups (montada só de leitura no docker-compose) —
# sem isto o monitor não consegue avisar quando o último backup está atrasado.
BACKUPS_DIR=
# Alerta os admins (notificação + email) quando o último dump tem mais de N horas.
BACKUP_MAX_HORAS=48
# Alerta quando o espaço livre na pasta de uploads desce abaixo de N MB.
DISCO_MIN_MB=1024

# ─── Digest semanal ────────────────────────────────────────
# Dia (0 = domingo … 6 = sábado) e hora (0-23, hora do servidor) do envio.
DIGEST_DIA_SEMANA=1
DIGEST_HORA=7

# ─── Retenção (limpeza diária; 0 desliga a purga respectiva) ─
RETENCAO_AUDITORIA_DIAS=365
RETENCAO_NOTIFICACOES_DIAS=90
RETENCAO_EVENTOS_DIAS=180

# Tamanho máximo (MB) da exportação de uma colecção em ZIP.
ZIP_LIMITE_MB=300
