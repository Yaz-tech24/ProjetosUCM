{
	# Directiva de terceiros (módulo caddy-ratelimit, compilado na imagem
	# custom em ./caddy/Dockerfile) — o Caddyfile precisa de saber onde a
	# encaixar na ordem fixa das directivas nativas.
	order rate_limit before basicauth
}

:80 {
	# Este Caddy já não é o ponto de entrada público — o Traefik (partilhado
	# pelo VPS entre vários projectos, fora deste docker-compose) é que fica
	# nas portas 80/443 do host, termina o TLS (Let's Encrypt via
	# certresolver, ver as labels "traefik.*" do serviço caddy no
	# docker-compose.yml) e encaminha para aqui internamente. Por isso o
	# Caddy escuta simplesmente em :80, sem domínio nem HTTPS próprios.

	encode gzip

	# API, ficheiros carregados (uploads) e o chat em tempo real (Socket.IO)
	# ficam todos no mesmo domínio que o frontend — evita CORS por completo.
	handle /api/* {
		# Travão básico por IP, à frente do rate limiting já existente ao
		# nível do Express — não o substitui, é só uma rede de segurança
		# contra uma inundação de pedidos antes de chegarem ao Node.
		# "key {remote_host}" agrupa por IP — num campus/rede móvel, uma
		# turma inteira (dimensionado para ~100 utilizadores activos em
		# simultâneo) pode aparecer atrás do mesmo IP de NAT, e cada
		# utilizador já gera vários pedidos/min normais (dashboard, chat,
		# materiais). 2000/min por IP continua a cortar picos grosseiros de
		# inundação sem bloquear uso legítimo de uma turma inteira — a
		# precisão fica com os limitadores do Express (por utilizador/IP,
		# ver middleware/rateLimiters.js).
		# Requer o módulo mholt/caddy-ratelimit — ver ./caddy/Dockerfile.
		rate_limit {
			zone api_zone {
				key {remote_host}
				events 2000
				window 1m
			}
		}
		reverse_proxy api:5000
	}
	handle /uploads/* {
		reverse_proxy api:5000
	}
	handle /socket.io/* {
		reverse_proxy api:5000
	}

	# Tudo o resto é o frontend (SPA servida pelo nginx do container web)
	handle {
		reverse_proxy web:80
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O helmet do Express só aplica HSTS às respostas de /api e /uploads —
		# a app (HTML/JS servido pelo nginx em web:80) nunca a recebia. Aqui,
		# fora de qualquer "handle", aplica-se a toda a resposta deste site
		# block, frontend incluído.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
