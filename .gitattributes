*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Scripts que correm no servidor Linux (VPS) — têm de manter LF mesmo que
# sejam commitados a partir do Windows, senão o shebang (#!/bin/sh) falha.
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
backup/crontab text eol=lf

# Normaliza fins de linha de todo o texto para LF no repositório (evita os
# avisos "LF will be replaced by CRLF" e diffs de ficheiro inteiro entre SOs).
* text=auto eol=lf
*.webp binary
*.mp4 binary
