# Copie este ficheiro para .env e preencha os valores reais antes de
# "docker compose up -d --build". NUNCA comite o .env real.

# ─── Domínio ─────────────────────────────────────────────────
# O domínio público pelo qual a plataforma vai ser acedida — frontend, API,
# uploads e chat em tempo real ficam TODOS neste único domínio, através do
# Caddy (ver Caddyfile), que também trata do HTTPS automaticamente (Let's
# Encrypt para um domínio real; para "localhost" usa um certificado próprio,
# só para testes locais — o browser mostra aviso de "não confiável").
#
# Antes de arrancar num servidor real, aponte o DNS deste domínio para o IP
# do servidor (registo A) e garanta que as portas 80 e 443 estão abertas.
DOMAIN=localhost

# ─── Base de dados ──────────────────────────────────────────
DB_NAME=ucm_smarthub
# Password do utilizador root do MySQL (gere uma password forte para produção)
DB_PASSWORD=

# ─── Autenticação ───────────────────────────────────────────
# Gere uma chave longa e aleatória para produção (ex: openssl rand -hex 32)
JWT_SECRET=

# ─── IA (Google Gemini) — opcional ──────────────────────────
GEMINI_API_KEY=

# ─── Email (SMTP) — opcional ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
