# Copie este ficheiro para .env e preencha os valores reais antes de
# "docker compose up -d --build". NUNCA comite o .env real.

# ─── Base de dados ──────────────────────────────────────────
DB_NAME=ucm_smarthub
# Password do utilizador root do MySQL (gere uma password forte para produção)
DB_PASSWORD=

# ─── URLs públicas ──────────────────────────────────────────
# URL pela qual o frontend (browser) acede à API — usada para construir
# links de ficheiros/uploads e é gravada no bundle do frontend em build-time.
API_URL=http://localhost:5000
# URL pública do frontend — usada para construir o link de recuperação de password.
FRONTEND_URL=http://localhost

# ─── Autenticação ───────────────────────────────────────────
# Gere uma chave longa e aleatória para produção (ex: openssl rand -hex 32)
JWT_SECRET=

# ─── IA (Google Gemini) — opcional ──────────────────────────
GEMINI_API_KEY=

# ─── Email (SMTP) — opcional ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
